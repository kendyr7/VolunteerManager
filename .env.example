# WhatsApp Cloud API
WHATSAPP_ENABLED=true
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WABA_ID=
META_APP_SECRET=

# Automatic reminders
# Generate a long random value and configure the same value in the deployment.
CRON_SECRET=
WHATSAPP_REMINDER_LEAD_DAYS=2
WHATSAPP_MESSAGING_LIMIT=250
WHATSAPP_CAPACITY_RESERVE_PERCENT=10

# Supabase server access
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini summaries (server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Custom application sessions. This must match the signing secret accepted by
# Supabase for the custom JWT used by browser RLS requests.
JWT_SECRET=

# WebAuthn / passkeys (exact production hostname and HTTPS origin)
WEBAUTHN_RP_ID=
WEBAUTHN_RP_ORIGIN=

# Web Push (server-only; see docs/web-push.md)
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://volunteermanager.org
PUSH_DISPATCH_SECRET=
